{
  "name": "luffyflow",
  "displayName": "LuffyFlow",
  "version": "0.1.0",
  "private": true,
  "description": "A Chromium extension for safely queueing prompts and organizing outputs on supported AI platforms.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "plasmo build --target=chrome-mv3",
    "dev": "plasmo dev --target=chrome-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "package": "plasmo package --target=chrome-mv3",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run test && corepack pnpm run format:check",
    "validate:release": "corepack pnpm run validate && corepack pnpm run test:coverage && corepack pnpm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.5.7",
    "@plasmohq/storage": "1.15.0",
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-router-dom": "6.30.4",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.2.0",
    "plasmo": "0.90.5",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "manifest": {
    "permissions": [
      "storage",
      "downloads",
      "tabs",
      "sidePanel",
      "alarms"
    ],
    "host_permissions": [
      "https://flow.google/*",
      "https://labs.google/*",
      "https://www.labs.google/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://www.grok.com/*",
      "https://x.com/*"
    ],
    "optional_host_permissions": [
      "https://api.example.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "incognito": "not_allowed"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
