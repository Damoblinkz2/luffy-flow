# Real HTTP mode sends API requests only to this validated base URL. The
# corresponding origin must also be declared in the production manifest.
PLASMO_PUBLIC_API_BASE_URL=http://localhost:8787/api/v1

# Use "production" only with a deployed HTTPS API URL.
PLASMO_PUBLIC_APP_ENV=development

# API requests are aborted after this bounded duration unless a call overrides it.
PLASMO_PUBLIC_API_TIMEOUT_MS=15000
