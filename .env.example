# Real HTTP mode sends API requests only to this validated base URL. The
# corresponding origin must also be declared in the production manifest.
PLASMO_PUBLIC_API_BASE_URL=https://api.example.com

# Mock mode is the safe development default and requires no production secrets.
PLASMO_PUBLIC_USE_MOCK_API=true
PLASMO_PUBLIC_APP_ENV=development

# Development-only controls make latency and failure behavior reproducible.
PLASMO_PUBLIC_MOCK_API_LATENCY_MS=500
PLASMO_PUBLIC_MOCK_API_FAILURE_RATE=0

# API requests are aborted after this bounded duration unless a call overrides it.
PLASMO_PUBLIC_API_TIMEOUT_MS=15000
